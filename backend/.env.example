# =============================================================================
# Star Platform - Backend Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Star API
APP_VERSION=0.1.0
DEBUG=false

# Server configuration
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins, or "*" to allow all
# For production, specify your frontend domain(s):
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*

# Frontend URL (used for generating links)
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection URL (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/star

# PostgreSQL connection URL (sync driver - for migrations)
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/star

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# IMPORTANT: Change this to a secure random string in production!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-in-production

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# GitHub API
# -----------------------------------------------------------------------------
# GitHub Personal Access Token for API access
# Create at: https://github.com/settings/tokens
# Required scopes: read:user, read:org
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Stack Overflow API
# -----------------------------------------------------------------------------
# Register your app at: https://stackapps.com/apps/oauth/register
STACKOVERFLOW_API_KEY=

# -----------------------------------------------------------------------------
# LLM Services (for natural language search)
# -----------------------------------------------------------------------------
# Groq API Key - https://console.groq.com/
GROQ_API_KEY=

# Google AI API Key (Gemini) - https://aistudio.google.com/
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Cache Settings
# -----------------------------------------------------------------------------
GITHUB_STATS_CACHE_HOURS=24
